# Frontend: deixe vazio para usar /api no próprio domínio.
REACT_APP_API_URL=
REACT_APP_GOOGLE_BOOKS_KEY=

# Backend: somente no servidor; nunca usar REACT_APP_ nesses segredos.
SECRET_KEY=replace-with-a-secure-random-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opcional: restrinja aos previews deste projeto, nunca a todos os vercel.app.
CORS_ALLOW_ORIGIN_REGEX=
CRON_SECRET=replace-with-another-secure-random-string
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER_TIMEOUT_SECONDS=20
BOOK_AI_PRIMARY_PROVIDER=groq
CATALOG_AI_PRIMARY_PROVIDER=groq
NOVI_PRIMARY_PROVIDER=gemini
# Enriquecimento de livros e fichas usa Flash-Lite para distribuir o volume.
GEMINI_BOOK_MODEL=gemini-3.5-flash-lite
GEMINI_BOOK_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_CATALOG_MODEL=gemini-3.5-flash-lite
GEMINI_CATALOG_FALLBACK_MODEL=gemini-2.5-flash
# A Novi usa Flash como principal e Flash-Lite como reserva para erros 429.
NOVI_GEMINI_MODEL=gemini-2.5-flash
NOVI_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
BACKUP_SEGURANCA_RETENCAO_HORAS=48

# Apenas para scripts de banco/CI, nunca para o frontend.
DATABASE_URL=
TEST_DATABASE_URL=
